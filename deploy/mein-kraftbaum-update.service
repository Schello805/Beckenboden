[Unit]
Description=Mein Kraftbaum kontrolliertes Update
After=network-online.target

[Service]
Environment=TZ=Europe/Berlin
Type=oneshot
User=root
ExecStart=/opt/mein-kraftbaum/deploy/update.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true

